`timescale 1ns / 1ps
module squarer(
input [3:0]A,
output [7:0]Y
);
wire n0,n1,n2,x1,x2,x3,x4,x5,x6,x7,x8,x9;
not g1(n0,A[0]);
not g2(n1,A[1]);
not g3(n2,A[2]);
assign Y[0]=A[0];
assign Y[1]=0;
and g4(Y[2],A[1],n0);
xor g5(x1,A[1],A[2]);
and g6(Y[3],x1,A[0]);
xor g7 (x2,A[3],A[2]);
and g8(x3,A[0],x2);
and g9(x4,n0,n1);
and g10(x5,A[2],x4);
or g11 (Y[4],x5,x3);
and g12(x6,x2,A[1]);
and g13(x7,A[3],A[2]);
and g14(x8,x7,A[0]);
or g15(Y[5],x6,x8);
or g16(x9,n2,A[1]);
and g17(Y[6],x9,A[3]);
and g18(Y[7],A[3],A[2]);


endmodule
